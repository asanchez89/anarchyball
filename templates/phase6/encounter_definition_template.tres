[gd_resource type="Resource" script_class="EncounterDefinition" load_steps=3 format=3]

[ext_resource type="Script" path="res://src/content/definitions/content_definition.gd" id="1_base"]
[ext_resource type="Script" path="res://src/content/definitions/encounter_definition.gd" id="2_encounter"]

[resource]
script = ExtResource("2_encounter")
content_id = &"encounter_template"
display_name = "Encounter Template"
entry_condition = &"on_section_enter"
objective = &"replace_objective"
enemy_archetype_ids = Array[StringName]([&"enemy_template"])
aggression_trigger_ids = Array[StringName]([&"attack_commit"])
success_condition_ids = Array[StringName]([&"replace_success"])
failure_condition_ids = Array[StringName]([&"player_defeated"])
surrender_condition_ids = Array[StringName]([&"resolve_depleted"])
allowed_resolutions = Array[StringName]([&"neutralize_aggressor", &"use_baseline_bypass"])
neutralization_resolution = &"neutralize_aggressor"
rule_interaction_resolution = &"use_baseline_bypass"
telemetry_tags = Array[StringName]([&"template"])
