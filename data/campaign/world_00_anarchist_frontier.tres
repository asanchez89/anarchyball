[gd_resource type="Resource" script_class="WorldDefinition" load_steps=6 format=3]

[ext_resource type="Script" path="res://src/campaign/world_definition.gd" id="1_world"]
[ext_resource type="Script" path="res://src/campaign/campaign_mission_definition.gd" id="2_mission"]
[ext_resource type="PackedScene" path="res://levels/world_0/w0_01_first_aggression.tscn" id="3_scene"]
[ext_resource type="PackedScene" path="res://levels/world_0/w0_02_contract_bridge.tscn" id="4_scene"]
[ext_resource type="PackedScene" path="res://levels/world_0/w0_03_occupancy_workshop.tscn" id="5_scene"]

[sub_resource type="Resource" id="Mission_first_aggression"]
script = ExtResource("2_mission")
mission_id = &"w0_01_first_aggression"
display_name = "01 · First Aggression"
mission_scene = ExtResource("3_scene")

[sub_resource type="Resource" id="Mission_contract_bridge"]
script = ExtResource("2_mission")
mission_id = &"w0_02_contract_bridge"
display_name = "02 · Contract Bridge"
mission_scene = ExtResource("4_scene")

[sub_resource type="Resource" id="Mission_occupancy_workshop"]
script = ExtResource("2_mission")
mission_id = &"w0_03_occupancy_workshop"
display_name = "03 · Occupancy Workshop"
mission_scene = ExtResource("5_scene")

[resource]
script = ExtResource("1_world")
world_id = &"world_00_anarchist_frontier"
display_name = "Anarchist Frontier"
missions = Array[ExtResource("2_mission")]([SubResource("Mission_first_aggression"), SubResource("Mission_contract_bridge"), SubResource("Mission_occupancy_workshop")])
