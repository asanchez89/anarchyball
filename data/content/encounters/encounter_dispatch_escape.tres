[gd_resource type="Resource" script_class="EncounterDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/content/definitions/encounter_definition.gd" id="1"]

[resource]
script = ExtResource("1")
content_id = &"encounter_dispatch_escape"
display_name = "Liberar el despacho"
objective = &"release_dispatch"
enemy_archetype_ids = Array[StringName]([&"enemy_occupancy_enforcer"])
