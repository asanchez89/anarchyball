[gd_resource type="Resource" script_class="EncounterDefinition" load_steps=3 format=3]

[ext_resource type="Script" path="res://src/content/definitions/content_definition.gd" id="1_base"]
[ext_resource type="Script" path="res://src/content/definitions/encounter_definition.gd" id="2_encounter"]

[resource]
script = ExtResource("2_encounter")
content_id = &"encounter_frontier_scout"
display_name = "Frontier Scout"
entry_condition = &"on_section_enter"
objective = &"cross_or_defend_against_scout"
enemy_archetype_ids = Array[StringName]([&"enemy_frontier_raider"])
aggression_trigger_ids = Array[StringName]([&"scout_attack_committed"])
success_condition_ids = Array[StringName]([&"scout_surrenders", &"scout_bypassed"])
failure_condition_ids = Array[StringName]([&"player_defeated"])
surrender_condition_ids = Array[StringName]([&"resolve_depleted"])
allowed_resolutions = Array[StringName]([&"force_scout_surrender", &"continue_past_scout"])
neutralization_resolution = &"force_scout_surrender"
telemetry_tags = Array[StringName]([&"introductory_resistance", &"single_enemy"])
