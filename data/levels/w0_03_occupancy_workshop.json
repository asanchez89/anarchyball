{
  "schema_version": 0,
  "level_id": "w0_03_occupancy_workshop",
  "display_name": "World 0 · Occupancy Workshop",
  "slice": {
    "title": "OCCUPANCY WORKSHOP",
    "objective": "Restore ◇ abandoned machines with F / X; pass ◆ occupied machines; resolve [?] disputes at the next ◇ alternate machine",
    "intro": "Follow the machine symbols. At ◇ ABANDONED, press F / gamepad X to restore and operate it. At ◆ OCCUPIED, there is nothing to activate: current use excludes a second operator, so continue right on the open route. At [?] DISPUTED, do not shoot; continue to the next ◇ alternate machine and operate it with F / X to resolve the encounter.",
    "completion": "The workshop remained useful while scarcity still required exclusion. Your route records restored machines, current-use bypasses and whether the title dispute ended through alternate operation or defensive surrender.",
    "briefing_cards": [
      {
        "title": "Reconocimiento: taller comunal",
        "body": "Parece un taller ocupado y todavía operativo. Hay máquinas que restaurar, rutas elevadas y patrullas entre las áreas de trabajo. Observa el estado de cada ball antes de disparar."
      },
      {
        "title": "PoliceBall de ocupación",
        "body": "Unidad hostil cuando ejecuta una detención o confiscación. Ataca con frecuencia y no se rinde: reduce su Resolve para neutralizarla y dejar de recibir fuego.",
        "image_path": "res://assets/art/actors/balls/world_0/runtime/occupancy_enforcer_ball_keyposes.png",
        "image_columns": 8,
        "image_frame": 0
      },
      {
        "title": "AncomBall",
        "body": "Patrulla desconfiada, pero no es enemiga por defecto. Puedes evitarla o retirarte. Si inicia una agresión, suele rendirse pronto ante una respuesta defensiva.",
        "image_path": "res://assets/art/actors/balls/world_0/runtime/ancom_ball_keyposes.png",
        "image_columns": 8,
        "image_frame": 0
      },
      {
        "title": "EgoistBall",
        "body": "Protege un alijo útil en una ruta elevada. Obtén el recurso antes de que termine su advertencia para resolver sin combatir. El alijo restaura salud; si EgoistBall ataca, puedes responder hasta que se rinda.",
        "image_path": "res://assets/art/actors/balls/world_0/runtime/egoist_ball_keyposes.png",
        "image_columns": 8,
        "image_frame": 0
      },
      {
        "title": "MutualistBall",
        "body": "Operadora neutral de maquinaria comunal. Habla con ella para entender el uso actual de cada máquina. No la ataques: las disputas del taller se resuelven operando o buscando otra ruta.",
        "image_path": "res://assets/art/actors/balls/world_0/runtime/mutualist_ball_keyposes.png",
        "image_columns": 8,
        "image_frame": 0
      }
    ]
  },
